# Copy this file to .env and fill in all values before running.

# Bearer token for PWA authentication — use a long random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RIZHI_BEARER_TOKEN=change-me-to-a-long-random-string

# VAPID keys for Web Push notifications
# Generate with: python -m server.push --generate-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=your@email.com

# Path to the Claude Code binary on the OCI VM
# Find with: which claude
CLAUDE_BIN=claude
